{
  "name": "gm-city",
  "private": true,
  "version": "0.1.0",
  "description": "경기도 광명시를 축소해 옮긴 복셀 아트 3D 미니어처 (타임라인·교통 시뮬레이션)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data:fetch": "node tools/fetch-osm.mjs && node tools/fetch-elevation.mjs",
    "data:build": "node tools/build-world.ts",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
